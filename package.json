{
  "name": "obsidian-pdf-excerpt",
  "version": "1.0.0",
  "description": "Excerpt text from PDFs into per-PDF markdown notes, with in-PDF highlighting.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "node --test tests/*.test.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "pdf",
    "excerpt",
    "highlight"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.1",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  }
}
